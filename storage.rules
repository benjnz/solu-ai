service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to agent branding (logos, avatars)
    match /agent_assets/{agentId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default rule: Authenticated read/write for everything else
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
